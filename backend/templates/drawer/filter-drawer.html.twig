{# Filter builder drawer (4.5), interim: the closed dialog; WP-FD fills it. #}
<dialog class="drawer" id="filterDrawer" aria-labelledby="filterDrawerTitle" data-preserve-attr="open">
    <div class="dialog-header">
        <h2 class="dialog-title" id="filterDrawerTitle">Filter builder</h2>
        <button type="button" data-variant="close" aria-label="Close the filter builder"
                data-on:click="el.closest('dialog').close()"></button>
    </div>
    <div class="dialog-body"></div>
</dialog>
