<!DOCTYPE html>
{% import 'shell/icons.html.twig' as icons %}
{% set activeMeta = shell.pagesMeta|filter(m => m.id == shell.activePage)|first %}
<html lang="en"
    data-density="{{ shell.defaults.density }}"
    {# Read by the head script, so a new instance default applies to a browser without its own choice. #}
    data-theme-default="{{ shell.defaults.theme }}"
    {# The client-local signals of 1.9, seeded on the element that persists them: an unseeded
       path reads back as '', which data-persist would store over the default for good. #}
    data-signals__ifmissing="{ {{ page.id() }}: '{{ shell.activePage }}', _darkMode: window.__nfsenTheme.dark, _themeChoice: window.__nfsenTheme.choice ?? 'default', _sidebarCollapsed: window.__nfsenSidebar.collapsed, _moreOpen: false, _optionsOpen_overview: false, _optionsOpen_talkers: false, _optionsOpen_flows: false, _optionsOpen_conversations: false, _prevRange: null, _autoSyncGraph: false, _graph_logscale: false, _graph_stacked: false, _graph_stepplot: true, _ov_optionsOpen: false, _ov_seriesOpen: true, _flows_tab: 'flows', _conv_view: 'sankey', _settings_tab: 'general', _drawer_tab: 'builder', _drawer_draftFor: '' }"
    data-persist="{_autoSyncGraph: $_autoSyncGraph, _graph_logscale: $_graph_logscale, _graph_stacked: $_graph_stacked, _graph_stepplot: $_graph_stepplot, _ov_optionsOpen: $_ov_optionsOpen, _ov_seriesOpen: $_ov_seriesOpen, _flows_tab: $_flows_tab, _conv_view: $_conv_view, _settings_tab: $_settings_tab, _drawer_tab: $_drawer_tab}"
    data-on:hashchange__window="window.nfsenRouter.follow(${{ page.id() }}, (p) => { ${{ page.id() }} = p; @post('{{ navigate.url() }}') })"
    {# Fallback for JS off entirely; the head script overrides it (#156, #167). #}
    {% if shell.defaults.theme == 'dark' %}data-theme="dark"{% elseif shell.defaults.theme == 'light' %}data-theme="light"{% endif %}
    data-attr:data-theme="$_darkMode ? 'dark' : 'light'"
    {# Dispatched by the head script whenever the resolved theme or the stored choice changes. #}
    data-on:nfsen-colorscheme__window="$_darkMode = evt.detail.dark; $_themeChoice = evt.detail.choice ?? 'default'"
    {# Keep the client's live theme across SSE morphs (#151). #}
    data-preserve-attr="data-theme">
<head>
    <meta charset="utf-8">
    {#
        Runs once, before anything reads the hash: a view persisted by the old tab layout
        becomes the page it maps to (D2), and both keys go, so a bare / opens the default view.
    #}
    <script>
        (function () {
            try {
                var read = function (key) {
                    var raw = localStorage.getItem('nfsen-persist:' + key);
                    localStorage.removeItem('nfsen-persist:' + key);
                    try { return raw === null ? null : JSON.parse(raw); } catch (e) { return null; }
                };
                var view = read('_currentView');
                var section = read('_settingsSection');
                var views = { graphs: 'overview', statistics: 'talkers', sankey: 'conversations', investigate: 'flows', flows: 'flows' };
                var sections = { import: 'health', health: 'health', alerts: 'alerts', preferences: 'settings', system: 'settings' };
                var page = view === 'settings' ? (sections[section] || 'settings') : views[view];
                if (page && (location.hash === '' || location.hash === '#')) {
                    history.replaceState(history.state, '', '#/' + page);
                }
            } catch (e) { /* storage disabled: nothing was persisted either */ }
        })();
    </script>
    {# Blocking, and above the stylesheets, so the wrong frame never paints first (#167, D8).
       Precedence: this browser's choice, else the instance default, else the OS. #}
    <script>
        (function () {
            var root = document.documentElement;
            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            var CHOICES = ['light', 'dark', 'system'];
            var KEY = 'nfsen-theme';
            var valid = function (value) { return CHOICES.indexOf(value) >= 0 ? value : null; };
            var choice = null;
            try {
                choice = valid(localStorage.getItem(KEY));
                // Pre-#167 key held the resolved value, so it cannot be told apart from an
                // auto-resolved one. Dropped rather than migrated.
                localStorage.removeItem('nfsen-persist:_darkMode');
            } catch (e) { /* storage disabled */ }

            // 'light', 'dark', or 'system'/'auto', which follow the OS.
            function resolve() {
                var pick = choice || root.getAttribute('data-theme-default') || 'auto';
                if (pick === 'dark' || pick === 'light') return pick === 'dark';
                return mq.matches;
            }

            var theme = {
                dark: resolve(),
                choice: choice,
                choose: function (next) {
                    choice = valid(next);
                    try {
                        if (choice) localStorage.setItem(KEY, choice);
                        else localStorage.removeItem(KEY);
                    } catch (e) { /* storage disabled: the choice lasts for this page */ }
                    apply(true);
                },
            };

            function apply(announce) {
                var dark = resolve();
                announce = announce || dark !== theme.dark;
                theme.dark = dark;
                theme.choice = choice;
                root.setAttribute('data-theme', dark ? 'dark' : 'light');
                if (announce) {
                    window.dispatchEvent(new CustomEvent('nfsen-colorscheme', { detail: { dark: dark, choice: choice } }));
                }
            }

            window.__nfsenTheme = theme;
            root.setAttribute('data-theme', theme.dark ? 'dark' : 'light');

            mq.addEventListener('change', function () { apply(false); });
            // A choice made in another tab of this browser.
            window.addEventListener('storage', function (e) {
                if (e.key !== KEY && e.key !== null) return;
                try { choice = valid(localStorage.getItem(KEY)); } catch (err) { choice = null; }
                apply(true);
            });
            // A new instance default, which a sync writes into data-theme-default.
            new MutationObserver(function () { apply(false); }).observe(root, { attributeFilter: ['data-theme-default'] });
        })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ activeMeta ? activeMeta.title ~ ' · ' : '' }}nfsen-ng</title>
    {# Derived from the Unraid app icon: same palette, simplified to stay legible at 16px (#170). #}
    <link rel="icon" type="image/svg+xml" href="{{ basePath }}favicon.svg?v={{ shell.assetVersion }}">
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="{{ basePath }}favicon.ico?v={{ shell.assetVersion }}">
    <link rel="apple-touch-icon" href="{{ basePath }}apple-touch-icon.png?v={{ shell.assetVersion }}">

    {# php-via SSE bootstrap, as in php-via's shell.html. _disconnected is client-local. #}
    <meta data-signals='{"via_ctx":"{{ contextId }}","_disconnected":false}'>
    <meta data-indicator="_connecting"
          data-on-interval__duration.15s.leading="!$_connecting && @get('{{ basePath }}_sse')"
          data-on:datastar-fetch="el === evt.detail.el &&
                             ((evt.detail.type.startsWith('datastar') && ($_disconnected = false)) ||
                             (['retrying', 'error', 'finished'].includes(evt.detail.type) && ($_disconnected = true)))">
    <meta data-init="window.addEventListener('beforeunload', () => { navigator.sendBeacon('{{ basePath }}_session/close', '{{ contextId }}'); });">
    {% for sheet in ['tokens', 'starbase', 'ui', 'shell', 'controls-bar', 'traffic-graph', 'query-kit', 'drawer', 'nfsen-ng', 'pages/overview', 'pages/talkers', 'pages/flows', 'pages/conversations', 'pages/alerts', 'pages/health', 'pages/settings'] %}
        <link rel="stylesheet" type="text/css" href="{{ basePath }}css/{{ sheet }}.css?v={{ shell.assetVersion }}">
    {% endfor %}
</head>

{# Routing (1.1): on load the hash is compared with the page the server rendered. On <body>, not
   <html>: the navigate post needs via_ctx, which the <head> seeds after <html> is processed. #}
<body class="app" data-attr:data-sidebar="$_sidebarCollapsed ? 'collapsed' : 'expanded'" data-preserve-attr="data-sidebar"
      data-server-page="{{ shell.activePage }}"
      data-init="window.nfsenRouter.start(el.dataset.serverPage, (p) => { ${{ page.id() }} = p; @post('{{ navigate.url() }}') })">
    {# Set before the first paint and seeds _sidebarCollapsed. Only the toggle stores it, so the
       tablet default (2.6) holds until someone chooses otherwise. #}
    <script>
        (function () {
            var KEY = 'nfsen-persist:_sidebarCollapsed';
            var collapsed = null;
            try { collapsed = JSON.parse(localStorage.getItem(KEY)); } catch (e) { /* none stored */ }
            if (typeof collapsed !== 'boolean') collapsed = window.matchMedia('(max-width: 63.98em)').matches;
            document.body.setAttribute('data-sidebar', collapsed ? 'collapsed' : 'expanded');
            window.__nfsenSidebar = {
                collapsed: collapsed,
                remember: function (value) {
                    try { localStorage.setItem(KEY, JSON.stringify(value)); } catch (e) { /* storage disabled */ }
                },
            };
        })();
    </script>
    {% include 'shell/sidebar.html.twig' %}

    <div class="app-main">
        {# On phones the sidebar is hidden, so its brand leads the controls row (2.7.11); on
           wider screens this wrapper has no box and the controls bar is a child of .app-main. #}
        <div class="app-top">
            <a class="app-brand" href="#/{{ shell.defaults.view }}" title="nfsen-ng home" aria-label="nfsen-ng home">{{ icons.icon('logo') }}</a>
            {% include 'shell/controls-bar.html.twig' %}
        </div>

        {# Shell notices (4.0.3): each level also has its glyph and says what happened in words. #}
        <div class="shell-notices">
            <div class="notice" data-level="warning" role="status"
                 hidden data-attr:hidden="!$_disconnected" data-preserve-attr="hidden">
                <span class="status-dot" data-level="warning" aria-hidden="true"></span>
                <span>Reconnecting to server...</span>
            </div>
            {% if shell.fatalError %}
                <div class="notice" data-level="error" role="alert">
                    <span class="status-dot" data-level="error" aria-hidden="true"></span>
                    <span><strong>Fatal error:</strong> {{ shell.fatalError }}</span>
                </div>
            {% endif %}
            {# Server banner, pushed by the server and dismissed here only. #}
            <div class="notice dismissible" data-level="error" role="alert"
                 {% if _error.string() == '' %}hidden{% endif %}
                 data-attr:hidden="!${{ _error.id() }}" data-preserve-attr="hidden">
                <span class="status-dot" data-level="error" aria-hidden="true"></span>
                <span data-text="${{ _error.id() }}">{{ _error.string() }}</span>
                <button type="button" data-variant="close" aria-label="Dismiss this error" title="Dismiss"
                        data-on:click="${{ _error.id() }} = ''"></button>
            </div>
        </div>

        <main id="page-content">
            {% include 'shell/page-header.html.twig' %}
            {% include 'shell/traffic-graph.html.twig' %}
            {% for meta in shell.pagesMeta %}
                {% set p = pages[meta.id] %}
                <section class="page" id="page-{{ meta.id }}" data-page="{{ meta.id }}"
                         aria-labelledby="pageTitle"
                         data-attr:hidden="${{ page.id() }} !== '{{ meta.id }}'" data-preserve-attr="hidden"
                         {% if p.active %}data-ready{% else %}hidden{% endif %}>
                    {% if p.active %}
                        {% include 'pages/' ~ meta.id ~ '.html.twig' %}
                    {% else %}
                        {% include 'shell/page-skeleton.html.twig' with {meta: meta} %}
                    {% endif %}
                </section>
            {% endfor %}
        </main>

        {% include 'shell/footer.html.twig' %}
    </div>

    {% include 'shell/bottom-tabs.html.twig' %}
    {% include 'drawer/filter-drawer.html.twig' %}

    {# The modal of this tab (D24): ip-info and the alert Test result, kept in ShellState and
       rendered on every sync; the dialog preserves its open attribute across the morph. #}
    <div id="modal-root">{{ shell.modalHtml|raw }}</div>
    {# DOM that client code and tests add; data-ignore-morph keeps it across syncs. #}
    <div id="client-root" data-ignore-morph></div>
    <div id="alerts-toast-container" class="toast-stack" data-ignore-morph></div>
    {# nfsen/clipboard announces copies here; a dialog that holds a copy button adds its own [data-announcer]. #}
    <p id="nfsen-announcer" class="visually-hidden" role="status" data-ignore-morph></p>

    <script src="{{ basePath }}js/echarts.min.js" defer></script>

    {# Before any module script (a later import map is ignored). Versioned, so a bare import
       resolves to the instance the script tags below load. #}
    <script type="importmap">{"imports": {
        "datastar": "{{ basePath }}js/datastar-rocket.js?v={{ shell.assetVersion }}",
        "nfsen/theme-colors": "{{ basePath }}js/components/theme-colors.js?v={{ shell.assetVersion }}",
        "nfsen/tz-utils": "{{ basePath }}js/components/tz-utils.js?v={{ shell.assetVersion }}",
        "nfsen/format": "{{ basePath }}js/components/format.js?v={{ shell.assetVersion }}",
        "nfsen/clipboard": "{{ basePath }}js/components/clipboard.js?v={{ shell.assetVersion }}",
        "nfsen/download": "{{ basePath }}js/components/download.js?v={{ shell.assetVersion }}",
        "nfsen/host-state": "{{ basePath }}js/components/host-state.js?v={{ shell.assetVersion }}",
        "nfsen/chunks": "{{ basePath }}js/components/chunks.js?v={{ shell.assetVersion }}"
    }}</script>

    <script type="module">
        import { tzOptions } from 'nfsen/tz-utils';
        window.tzOptions = tzOptions;
    </script>

    {# These define window.* helpers that data-init and data-effect expressions read while Datastar walks the DOM,
       so they run before its bundle. chunks, like clipboard below, uses its import-map URL: one module instance. #}
    <script type="module" src="{{ basePath }}js/components/nfsen-router.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/components/alert-template-preview.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/components/filter-drawer.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/components/chunks.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/datastar-rocket.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/components/datastar-persist.js?v={{ shell.assetVersion }}"></script>
    {# clipboard is also an import-map target, so its tag uses the identical URL: one module instance. #}
    {% for component in ['nfsen-chart', 'nfsen-sankey', 'nfsen-matrix', 'nfsen-table', 'nfsen-toast', 'nfsen-filter-editor', 'nfsen-controls', 'clipboard'] %}
        <script type="module" src="{{ basePath }}js/components/{{ component }}.js?v={{ shell.assetVersion }}"></script>
    {% endfor %}
    {# Vendored Starbase components with "load": true in their lock; the folder name is the version. #}
    {% for module in shell.starbaseModules %}
        <script type="module" src="{{ basePath }}{{ module }}"></script>
    {% endfor %}

    {# A skipped or aborted transition still runs fn and only loses the animation, so its
       rejections are expected; an error thrown by fn still surfaces through updateCallbackDone. #}
    <script>
        window.withViewTransition = (fn) => {
            if (!document.startViewTransition) return fn();
            const transition = document.startViewTransition(fn);
            transition.ready.catch(() => {});
            transition.finished.catch(() => {});
            return transition;
        };
    </script>
</body>
</html>
