<!DOCTYPE html>
{% set activeMeta = shell.pagesMeta|filter(m => m.id == shell.activePage)|first %}
<html lang="en"
    data-density="{{ shell.defaults.density }}"
    {# The client-local signals of 1.9, seeded on the element that persists them: an unseeded
       path reads back as '', which data-persist would store over the default for good. #}
    data-signals__ifmissing="{ {{ page.id() }}: '{{ shell.activePage }}', _darkMode: window.__nfsenTheme.dark, _sidebarCollapsed: window.matchMedia('(max-width: 63.98em)').matches, _moreOpen: false, _optionsOpen_overview: false, _optionsOpen_talkers: false, _optionsOpen_flows: false, _optionsOpen_conversations: false, _prevRange: null, _autoSyncGraph: false, _graph_logscale: false, _graph_stacked: false, _graph_stepplot: true, _ov_optionsOpen: false, _ov_seriesOpen: true, _flows_tab: 'flows', _conv_view: 'sankey', _settings_tab: 'general', _drawer_tab: 'builder', _drawer_draftFor: '' }"
    data-persist="{_sidebarCollapsed: $_sidebarCollapsed, _autoSyncGraph: $_autoSyncGraph, _graph_logscale: $_graph_logscale, _graph_stacked: $_graph_stacked, _graph_stepplot: $_graph_stepplot, _ov_optionsOpen: $_ov_optionsOpen, _ov_seriesOpen: $_ov_seriesOpen, _flows_tab: $_flows_tab, _conv_view: $_conv_view, _settings_tab: $_settings_tab, _drawer_tab: $_drawer_tab}"
    data-on:hashchange__window="window.nfsenRouter.follow(${{ page.id() }}, (p) => { ${{ page.id() }} = p; @post('{{ navigate.url() }}') })"
    {# Fallback for JS off entirely; the head script overrides it (#156, #167). #}
    {% if shell.defaults.theme == 'dark' %}data-theme="dark"{% elseif shell.defaults.theme == 'light' %}data-theme="light"{% endif %}
    data-attr:data-theme="$_darkMode ? 'dark' : 'light'"
    {# Dispatched by the head script's matchMedia listener. #}
    data-on:nfsen-colorscheme__window="$_darkMode = evt.detail.dark"
    {# Keep the client's live theme across SSE morphs (#151). #}
    data-preserve-attr="data-theme">
<head>
    <meta charset="utf-8">
    {#
        Runs once, before anything reads the hash: a view persisted by the old tab layout
        becomes the page it maps to (D2), and both keys go, so a bare / opens the default view.
    #}
    <script>
        (function () {
            try {
                var read = function (key) {
                    var raw = localStorage.getItem('nfsen-persist:' + key);
                    localStorage.removeItem('nfsen-persist:' + key);
                    try { return raw === null ? null : JSON.parse(raw); } catch (e) { return null; }
                };
                var view = read('_currentView');
                var section = read('_settingsSection');
                var views = { graphs: 'overview', statistics: 'talkers', sankey: 'conversations', investigate: 'flows', flows: 'flows' };
                var sections = { import: 'health', health: 'health', alerts: 'alerts', preferences: 'settings', system: 'settings' };
                var page = view === 'settings' ? (sections[section] || 'settings') : views[view];
                if (page && (location.hash === '' || location.hash === '#')) {
                    history.replaceState(history.state, '', '#/' + page);
                }
            } catch (e) { /* storage disabled: nothing was persisted either */ }
        })();
    </script>
    {# Blocking, and above the stylesheets, so the light frame never paints first (#167).
       Precedence: explicit toggle, else NFSEN_DEFAULT_THEME, else the OS. #}
    <script>
        (function () {
            var DEFAULT = {{ shell.defaults.theme|json_encode|raw }};
            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            var choice = null;
            try {
                choice = localStorage.getItem('nfsen-theme');
                // Pre-#167 key held the resolved value, so it cannot be told apart from an
                // auto-resolved one. Dropped rather than migrated.
                localStorage.removeItem('nfsen-persist:_darkMode');
            } catch (e) { /* storage disabled */ }

            function resolve() {
                if (choice === 'dark' || choice === 'light') return choice === 'dark';
                if (DEFAULT === 'dark') return true;
                if (DEFAULT === 'light') return false;
                return mq.matches;
            }

            function apply(dark) {
                document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            }

            window.__nfsenTheme = {
                dark: resolve(),
                choose: function (dark) {
                    choice = dark ? 'dark' : 'light';
                    try { localStorage.setItem('nfsen-theme', choice); } catch (e) {}
                },
            };
            apply(window.__nfsenTheme.dark);

            // With no explicit choice, follow the OS live; the event moves the signal too.
            mq.addEventListener('change', function (e) {
                if (choice === 'dark' || choice === 'light') return;
                window.__nfsenTheme.dark = e.matches;
                apply(e.matches);
                window.dispatchEvent(new CustomEvent('nfsen-colorscheme', { detail: { dark: e.matches } }));
            });
        })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ activeMeta ? activeMeta.title ~ ' · ' : '' }}nfsen-ng</title>
    {# Derived from the Unraid app icon: same palette, simplified to stay legible at 16px (#170). #}
    <link rel="icon" type="image/svg+xml" href="{{ basePath }}favicon.svg?v={{ shell.assetVersion }}">
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="{{ basePath }}favicon.ico?v={{ shell.assetVersion }}">
    <link rel="apple-touch-icon" href="{{ basePath }}apple-touch-icon.png?v={{ shell.assetVersion }}">

    {# php-via SSE bootstrap, as in php-via's shell.html. _disconnected is client-local. #}
    <meta data-signals='{"via_ctx":"{{ contextId }}","_disconnected":false}'>
    <meta data-indicator="_connecting"
          data-on-interval__duration.15s.leading="!$_connecting && @get('{{ basePath }}_sse')"
          data-on:datastar-fetch="el === evt.detail.el &&
                             ((evt.detail.type.startsWith('datastar') && ($_disconnected = false)) ||
                             (['retrying', 'error', 'finished'].includes(evt.detail.type) && ($_disconnected = true)))">
    <meta data-init="window.addEventListener('beforeunload', () => { navigator.sendBeacon('{{ basePath }}_session/close', '{{ contextId }}'); });">
    {% for sheet in ['tokens', 'ui', 'shell', 'controls-bar', 'traffic-graph', 'query-kit', 'drawer', 'nouislider.min', 'nfsen-ng', 'pages/overview', 'pages/talkers', 'pages/flows', 'pages/conversations', 'pages/alerts', 'pages/health', 'pages/settings'] %}
        <link rel="stylesheet" type="text/css" href="{{ basePath }}css/{{ sheet }}.css?v={{ shell.assetVersion }}">
    {% endfor %}
</head>

{# Routing (1.1): on load the hash is compared with the page the server rendered. On <body>, not
   <html>: the navigate post needs via_ctx, which the <head> seeds after <html> is processed. #}
<body class="app" data-attr:data-sidebar="$_sidebarCollapsed ? 'collapsed' : 'expanded'" data-preserve-attr="data-sidebar"
      data-server-page="{{ shell.activePage }}"
      data-init="window.nfsenRouter.start(el.dataset.serverPage, (p) => { ${{ page.id() }} = p; @post('{{ navigate.url() }}') })">
    {% include 'shell/sidebar.html.twig' %}

    <div class="app-main">
        {% include 'shell/controls-bar.html.twig' %}

        <div class="shell-notices">
            <div class="notice" data-level="warning" role="status"
                 hidden data-attr:hidden="!$_disconnected" data-preserve-attr="hidden">
                Reconnecting to server...
            </div>
            {% if shell.fatalError %}
                <div class="notice" data-level="error" role="alert">
                    <strong>Fatal error:</strong> {{ shell.fatalError }}
                </div>
            {% endif %}
            {# Server banner, pushed by the server and dismissed here only. #}
            <div class="notice dismissible" data-level="error" role="alert"
                 {% if _error.string() == '' %}hidden{% endif %}
                 data-attr:hidden="!${{ _error.id() }}" data-preserve-attr="hidden">
                <span data-text="${{ _error.id() }}">{{ _error.string() }}</span>
                <button type="button" data-variant="close" aria-label="Dismiss"
                        data-on:click="${{ _error.id() }} = ''"></button>
            </div>
        </div>

        <main id="page-content">
            {% include 'shell/page-header.html.twig' %}
            {% include 'shell/traffic-graph.html.twig' %}
            {% for meta in shell.pagesMeta %}
                {% set p = pages[meta.id] %}
                <section class="page" id="page-{{ meta.id }}" data-page="{{ meta.id }}"
                         aria-labelledby="pageTitle"
                         data-attr:hidden="${{ page.id() }} !== '{{ meta.id }}'" data-preserve-attr="hidden"
                         {% if p.active %}data-ready{% else %}hidden{% endif %}>
                    {% if p.active %}
                        {% include 'pages/' ~ meta.id ~ '.html.twig' %}
                    {% else %}
                        {% include 'shell/page-skeleton.html.twig' with {meta: meta} %}
                    {% endif %}
                </section>
            {% endfor %}
        </main>

        {% include 'shell/footer.html.twig' %}
    </div>

    {% include 'shell/bottom-tabs.html.twig' %}
    {% include 'drawer/filter-drawer.html.twig' %}

    {# The server-rendered modal (D24); ip-info replaces #ip-modal-placeholder by id. #}
    <div id="modal-root">{% if shell.modalHtml %}{{ shell.modalHtml|raw }}{% else %}<div id="ip-modal-placeholder"></div>{% endif %}</div>
    {# Tooltips and toasts are appended by JS; data-ignore-morph keeps them across syncs. #}
    <div id="nfsen-tip-container" data-ignore-morph></div>
    <div id="alerts-toast-container" data-ignore-morph></div>

    {# The noUiSlider range picker stays until the controls bar replaces it (WP-CB). #}
    <script src="{{ basePath }}js/nouislider.min.js" defer></script>
    <script src="{{ basePath }}js/echarts.min.js" defer></script>

    {# Before any module script (a later import map is ignored). Versioned, so a bare import
       resolves to the instance the script tags below load. #}
    <script type="importmap">{"imports": {
        "datastar": "{{ basePath }}js/datastar.js?v={{ shell.assetVersion }}",
        "nfsen/theme-colors": "{{ basePath }}js/components/theme-colors.js?v={{ shell.assetVersion }}",
        "nfsen/tz-utils": "{{ basePath }}js/components/tz-utils.js?v={{ shell.assetVersion }}"
    }}</script>

    <script type="module">
        import { tzOptions } from 'nfsen/tz-utils';
        window.tzOptions = tzOptions;
    </script>

    {# Both define window.* helpers that data-init and data-effect expressions read while
       Datastar walks the DOM, so they run before datastar.js (module order is document order). #}
    <script type="module" src="{{ basePath }}js/components/nfsen-router.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/components/alert-template-preview.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/datastar.js?v={{ shell.assetVersion }}"></script>
    <script type="module" src="{{ basePath }}js/components/datastar-persist.js?v={{ shell.assetVersion }}"></script>
    {% for component in ['nfsen-chart', 'nfsen-sankey', 'nfsen-matrix', 'nfsen-table', 'nfsen-daterange', 'nfsen-toast', 'nfsen-tooltip', 'nfsen-filter-manager', 'nfsen-filter-editor', 'nfsen-controls'] %}
        <script type="module" src="{{ basePath }}js/components/{{ component }}.js?v={{ shell.assetVersion }}"></script>
    {% endfor %}

    {# A skipped or aborted transition still runs fn and only loses the animation, so its
       rejections are expected; an error thrown by fn still surfaces through updateCallbackDone. #}
    <script>
        window.withViewTransition = (fn) => {
            if (!document.startViewTransition) return fn();
            const transition = document.startViewTransition(fn);
            transition.ready.catch(() => {});
            transition.finished.catch(() => {});
            return transition;
        };
    </script>
</body>
</html>
