{#
    Health (4.7), interim: the import controls and the grouped checks of the old Settings
    view, one card each.
#}
<div class="stack">
    <section class="card" aria-labelledby="healthImportTitle">
        <header><h2 id="healthImportTitle">Import</h2></header>
        <div class="card-body stack">
            {# Action buttons #}
            <div>

            {% if daemonDisabled or daemonsInfo is empty %}

                <p class="muted">
                    Import daemon is disabled (<code>NFSEN_SKIP_DAEMON=1</code>).
                </p>

            {% elseif daemonsInfo|length > 1 %}

                {# Multi-profile daemon table #}
                <div class="card">
                    <div class="cluster card-header strong muted cluster-between">
                        Import Daemon
                    </div>
                    <div class="card-body">
                <table class="muted">
                    <thead>
                        <tr>
                            <th>Profile</th>
                            <th>Status</th>
                            <th>Last auto-import</th>
                            <th>Dirs watched</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for profile, info in daemonsInfo %}
                    <tr>
                        <td class="mono">{{ profile }}</td>
                        <td>
                            {% if info.ready %}
                                <span class="badge" data-level="success">ready</span>
                            {% else %}
                                <span class="badge text-warning" data-level="warning">init&hellip;</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if info.lastAutoImport > 0 %}
                                <span data-text="new Date({{ info.lastAutoImport }} * 1000).toLocaleString(undefined, tzOptions(${{ displayTz.id() }}, ${{ nfcapdTz.id() }}))"></span>
                            {% else %}
                                <span class="muted">never</span>
                            {% endif %}
                        </td>
                        <td>{{ info.watchCount }}</td>
                        <td>
                            <div class="cluster">
                                <button data-size="sm" data-variant="primary"
                                        data-attr:disabled="${{ import_running.id() }}"
                                        data-show="!${{ import_running.id() }}"
                                        data-on:click="${{ admin_target_profile.id() }} = '{{ profile }}'; @post('{{ triggerImport.url() }}')">
                                    Trigger
                                </button>
                                {% if datasourceAcceptsHistoricWrites %}
                                <button data-size="sm"
                                        data-attr:disabled="${{ import_running.id() }}"
                                        data-show="!${{ import_running.id() }}"
                                        title="Re-reads every capture file, including those older than the newest sample. Nothing is deleted."
                                        data-on:click="${{ admin_target_profile.id() }} = '{{ profile }}'; @post('{{ backfillImport.url() }}')">
                                    Backfill
                                </button>
                                {% else %}
                                <button class="kill" data-size="sm"
                                        data-attr:disabled="${{ import_running.id() }}"
                                        data-show="!${{ confirm_rescan.id() }} && !${{ import_running.id() }}"
                                        data-on:click="${{ admin_target_profile.id() }} = '{{ profile }}'; ${{ confirm_rescan.id() }} = true">
                                    Rescan
                                </button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
                    </div>
                </div>

                {# Shared confirm-rescan dialog (shown after clicking Rescan for any profile) #}
                {% if not datasourceAcceptsHistoricWrites %}
                <div data-show="${{ confirm_rescan.id() }}" style="display: none;" >
                    <div class="cluster">
                        <span class="text-danger strong muted">
                            Resets all {{ deployDatasource }} data for
                            <strong><span data-text="${{ admin_target_profile.id() }}"></span></strong>
                            and re-imports from scratch.
                        </span>
                        <button data-variant="danger" data-size="sm"
                                data-attr:disabled="${{ import_running.id() }}"
                                data-on:click="@post('{{ forceRescan.url() }}')">
                            Confirm &amp; Rescan
                        </button>
                        <button data-size="sm"
                                data-on:click="${{ confirm_rescan.id() }} = false">
                            Cancel
                        </button>
                    </div>
                </div>
                {% endif %}

                {# Cancel, only while an import is running #}
                <div class="cluster">
                    <button data-variant="primary"
                            data-show="${{ import_running.id() }}" style="display: none;"
                            data-indicator:_cancel_loading
                            data-on:click="@post('{{ cancelImport.url() }}')">
                        <span data-show="$_cancel_loading" style="display: none;" class="spinner" role="status" aria-hidden="true"></span>
                        <svg data-show="!$_cancel_loading" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                        </svg>
                        Cancel Import
                    </button>

                    {# Port scanning, only when ports are configured #}
                    {% if hasPorts %}
                    <div class="choice">
                        <input type="checkbox"  id="adminScanPorts"
                               {{ bind(import_scan_ports) }}
                               data-attr:disabled="${{ import_running.id() }}">
                        <label class="muted" for="adminScanPorts">Scan ports</label>
                    </div>
                    {% endif %}
                </div>

            {% else %}

                {# Single-profile action buttons #}
                <div class="cluster">

                <button data-variant="primary"
                        data-attr:disabled="${{ import_running.id() }}"
                        data-show="!${{ import_running.id() }}"
                        data-on:click="@post('{{ triggerImport.url() }}')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                    </svg>
                    Trigger Import
                </button>

                {% if datasourceAcceptsHistoricWrites %}
                <button 
                        data-attr:disabled="${{ import_running.id() }}"
                        data-show="!${{ import_running.id() }}"
                        title="Re-reads every capture file, including those older than the newest sample. Nothing is deleted."
                        data-on:click="@post('{{ backfillImport.url() }}')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z"/>
                        <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308c-.12.1-.12.284 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466"/>
                    </svg>
                    Backfill
                </button>
                {% else %}
                <button class="kill"
                        data-attr:disabled="${{ import_running.id() }}"
                        data-show="!${{ confirm_rescan.id() }} && !${{ import_running.id() }}"
                        data-on:click="${{ confirm_rescan.id() }} = true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z"/>
                        <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308c-.12.1-.12.284 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466"/>
                    </svg>
                    Force Rescan
                </button>
                {% endif %}

                <button data-variant="primary"
                        data-show="${{ import_running.id() }}" style="display: none;"
                        data-indicator:_cancel_loading
                        data-on:click="@post('{{ cancelImport.url() }}')">
                    <span data-show="$_cancel_loading" style="display: none;" class="spinner" role="status" aria-hidden="true"></span>
                    <svg data-show="!$_cancel_loading" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"  viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                    </svg>
                    Cancel Import
                </button>

                {% if not datasourceAcceptsHistoricWrites %}
                <div data-show="${{ confirm_rescan.id() }}" style="display: none;">
                    <div class="cluster">
                    <span class="text-danger strong muted">
                        Resets all {{ deployDatasource }} data and re-imports from scratch.
                    </span>
                    <button data-variant="danger" data-size="sm"
                            data-attr:disabled="${{ import_running.id() }}"
                            data-on:click="@post('{{ forceRescan.url() }}')">
                        Confirm &amp; Rescan
                    </button>
                    <button data-size="sm"
                            data-on:click="${{ confirm_rescan.id() }} = false">
                        Cancel
                    </button>
                    </div>
                </div>
                {% endif %}

                {# Port scanning, only when ports are configured #}
                {% if hasPorts %}
                <div class="choice">
                    <input type="checkbox"  id="adminScanPorts"
                           {{ bind(import_scan_ports) }}
                           data-attr:disabled="${{ import_running.id() }}">
                    <label class="muted" for="adminScanPorts">Scan ports</label>
                </div>
                {% endif %}

                </div>

            {% endif %}

            </div>{# /action buttons #}

            {# Progress, while an import runs #}
            <div data-show="${{ import_running.id() }}" style="display: none;" >
                <div class="cluster cluster-between">
                    <small class="muted">{{ importStatusText }}</small>
                    <small class="strong">{{ importProgress }}%{% if importEta %} · {{ importEta }}{% endif %}</small>
                </div>
                <progress class="import-progress" max="100" value="{{ importProgress }}">{{ importProgress }}%</progress>
                <div class="muted{{ importCurrentFile ? '' : ' invisible' }}">
                    Current: <code>{{ importCurrentFile ?: '…' }}</code>
                </div>
            </div>

            {# Import status, after completion #}
            {% if importStatusText and not import_running.getValue() %}
            <div>
                <div class="notice muted" data-level="{{ importLog|filter(e => e.level <= 3)|length > 0 ? 'error' : (importLog|length > 0 ? 'warning' : 'success') }}">
                    {{ importStatusText }}
                </div>
            </div>
            {% endif %}

            {# Import log #}
            {% if importLog|length > 0 %}
            <div>
                <div class="card">
                    <div class="card-header muted strong text-warning" data-level="warning">
                        Import log ({{ importLog|length }} warning{{ importLog|length != 1 ? 's' : '' }})
                    </div>
                    <div class="card-body">
                        <div  style="max-height: 240px;">
                            <table class="mono muted">
                                <tbody>
                                {% for entry in importLog|reverse %}
                                    <tr data-level="{{ entry.level <= 3 ? 'error' : 'warning' }}">
                                        <td class="muted" style="width:1%"><span data-text="new Date({{ entry.ts }} * 1000).toLocaleString('sv', {timeStyle:'medium'})">{{ entry.ts|date('H:i:s') }}</span></td>
                                        <td>{{ entry.msg }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </section>

    {% set hcErrors = healthChecks|filter(c => c.status == 'error')|length %}
    {% set hcWarnings = healthChecks|filter(c => c.status == 'warning')|length %}
    <div>
        <div class="card">
            <div class="cluster card-header strong cluster-between">
                System Health
                <span>
                    {% if hcErrors > 0 %}
                        <span class="badge" data-level="error">{{ hcErrors }} error{{ hcErrors != 1 ? 's' : '' }}</span>
                    {% elseif hcWarnings > 0 %}
                        <span class="badge text-warning" data-level="warning">{{ hcWarnings }} warning{{ hcWarnings != 1 ? 's' : '' }}</span>
                    {% else %}
                        <span class="badge" data-level="success">All checks passed</span>
                    {% endif %}
                </span>
            </div>
            <div class="card-body">
                <table>
                    <tbody>
                        {% for check in healthChecks %}
                        {% if loop.first or check.group != healthChecks[loop.index0 - 1].group %}
                        <tr class="row-group">
                            <th colspan="2" scope="colgroup">{{ check.group }}</th>
                        </tr>
                        {% endif %}
                        <tr data-level="{{ check.status == 'error' ? 'error' : (check.status == 'warning' ? 'warning' : '') }}">
                            <td  style="width:40%">
                                <span class="text-{{ check.status == 'error' ? 'danger' : (check.status == 'warning' ? 'warning' : 'success') }}">●</span>
                                {{ check.label }}
                            </td>
                            <td class="muted">
                                {% if check.code %}<code>{{ check.detail }}</code>{% else %}{{ check.detail|raw }}{% endif %}
                                {% if check.epoch > 0 %}
                                    <br><span class="mono" style="font-size:.85em" data-text="new Date({{ check.epoch }} * 1000).toLocaleString(undefined, tzOptions(${{ displayTz.id() }}, ${{ nfcapdTz.id() }}))">{{ check.epoch|date('Y-m-d H:i:s') }}</span>
                                {% endif %}
                                {% if check.hint %}
                                    <br><small class="muted" style="opacity:.65; font-size:.78em">{{ check.hint }}</small>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="2" class="muted italic">No checks available.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
