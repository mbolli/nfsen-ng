{#
    Flow query filter controls.

    The aggregation controls live in their own partial, because the Flow Records statistic
    takes the same eight settings (#174). The server never reads flows_outputFormat
    (hardcoded to JSON); it is kept as a client-local signal initialised here so the UI state
    is preserved across re-renders.
#}
<div class="filter-grid">

    {# Limit #}
    <div id="filterFlowsLimit" class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Limit Flows
            <nfsen-tooltip data-ignore-morph text="Maximum number of flow records to display (-c option)." placement="top"></nfsen-tooltip>
        </p>
        {% set _flowLimit = flows_limit.int() %}
        <select class="form-control form-select" {{ bind(flows_limit) }}>
            {% for n in [20, 50, 100, 500, 1000, 10000] %}
            <option value="{{ n }}"{{ _flowLimit == n ? ' selected' : '' }}>{{ n }}</option>
            {% endfor %}
        </select>
        </div>
    </div>

    <div id="filterFlowSources" class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Sources
            <nfsen-tooltip data-ignore-morph text="NetFlow sources to query. Multiple sources merged with -M." placement="top"></nfsen-tooltip>
        </p>
        <select {{ bind(graph_sources) }} multiple class="form-control form-select">
            <option value="any">Any</option>
            {% for source in sources %}
            <option value="{{ source }}" selected>{{ source }}</option>
            {% endfor %}
        </select>
        </div>
    </div>

    <div class="filter-cell filter-cell--wide">
        <div class="filter-group">
        <p class="filter-label">NFDUMP filter
            <nfsen-tooltip data-ignore-morph text="Filter syntax similar to tcpdump/pcap. Example: dst port 80" placement="right"></nfsen-tooltip>
        </p>
        <textarea class="form-control" id="filterNfdumpTextarea"
                  {{ bind(flows_filter) }} rows="3" autocomplete="on"></textarea>
        <nfsen-filter-manager
            data-ignore-morph
            data-target-textarea="filterNfdumpTextarea"
            data-default-filters="{{ filters|json_encode }}">
        </nfsen-filter-manager>
        </div>
    </div>

    {# Byte thresholds, prepended to the nfdump filter expression. One card rather than
       two: a single narrow input each left them stranded in half-empty cards, and they
       are one setting with two ends. #}
    <div class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Bytes per flow
            <nfsen-tooltip data-ignore-morph text="Keep only flows within this byte range. Prepended to the filter as 'bytes &gt; min' / 'bytes &lt; max'. Accepts SI suffixes: k, M, G." placement="top"></nfsen-tooltip>
        </p>
        <div class="filter-subgrid filter-subgrid--tight">
            <div>
                <label class="filter-sublabel" for="flows_lower_limitInput">Min</label>
                <input type="text" id="flows_lower_limitInput" {{ bind(flows_lower_limit) }} class="form-control" placeholder="e.g. 1M"
                       title="Only show flows with at least this many bytes. Prepended as 'bytes &gt; value'. Accepts SI suffixes: k, M, G.">
            </div>
            <div>
                <label class="filter-sublabel" for="flows_upper_limitInput">Max</label>
                <input type="text" id="flows_upper_limitInput" {{ bind(flows_upper_limit) }} class="form-control" placeholder="e.g. 100M"
                       title="Only show flows with at most this many bytes. Prepended as 'bytes &lt; value'. Accepts SI suffixes: k, M, G.">
            </div>
        </div>
        </div>
    </div>

    {# Aggregation & output #}
    <div id="filterFlowAggregation" class="filter-cell filter-cell--wide">
        <div class="filter-group">
        <p class="filter-label mb-2">Aggregation &amp; Output
            <nfsen-tooltip data-ignore-morph text="Aggregate flows: Bi-directional (-b), Protocol, Port, IP/prefix, or sort by tstart." placement="top"></nfsen-tooltip>
        </p>
        <div class="filter-subgrid">

            {% include 'partials/aggregation-controls.html.twig' with {
                idPrefix: 'filterFlow',
                aggBidirectional: flows_agg_bidirectional,
                aggProto: flows_agg_proto,
                aggSrcPort: flows_agg_srcport,
                aggDstPort: flows_agg_dstport,
                aggSrcIp: flows_agg_srcip,
                aggSrcIpPrefix: flows_agg_srcip_prefix,
                aggDstIp: flows_agg_dstip,
                aggDstIpPrefix: flows_agg_dstip_prefix
            } only %}

            {# Output options #}
            <div class="col" id="filterOutput">
                <label class="filter-sublabel">Options</label>
                <div id="flowsFilterOther">
                    <input type="checkbox" class="btn-check" name="ordertstart"
                           id="flowsFilterOrderTstart" {{ bind(flows_orderByTstart) }}>
                    <label class="btn btn-outline-primary btn-sm" for="flowsFilterOrderTstart">Order by tstart</label>
                </div>
            </div>

        </div>
        </div>
    </div>

    {# Submit. Flex, because the progress button's own root is a block-level flex container:
       left to itself it drops below any sibling control on this row. #}
    <div class="filter-submit border-top mt-2 pt-3 d-flex align-items-center gap-2 flex-wrap">
        {#
            The query runs in a coroutine now, so query_running (server-owned) is what says
            whether it is still going — not Datastar's request indicator, which clears the
            moment the action returns. Progress is a byte-read estimate, hence exact=false.
        #}
        <nfsen-tooltip data-ignore-morph text="Execute nfdump query with current filters" placement="top" no-icon>
            {% include 'partials/progress-button.html.twig' with {
                id: 'flowsRun',
                label: 'Process data',
                action: flowActions.url(),
                killAction: killNfdump.url(),
                running: query_running.id(),
                permille: query_permille.id(),
                status: query_status.id(),
                eta: query_eta.id(),
                exact: query_exact.id(),
                kindSignal: query_kind.id(),
                kind: 'flows',
                onClick: '$_flows_queried = true; ',
            } only %}
        </nfsen-tooltip>
    </div>

</div>
