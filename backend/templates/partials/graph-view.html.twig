{# Overview graph options; the chart is the shell's traffic graph, reached as $graph._widget. #}
<div id="graphOptions" class="filter-grid">

    {# Resolution slider #}
    <div class="filter-cell filter-cell--wide">
        <div class="filter-group">
        <p class="filter-label">Resolution</p>
        <div>
            <label for="resolutionSlider">
                Data Points: <strong data-text="${{ graph_resolution.id() }}"></strong>
            </label>
            <input type="range"
                   id="resolutionSlider"
                   min="50" max="2000" step="50"
                   {{ bind(graph_resolution) }}
                   title="Number of data points (higher = more detail)"
                   data-on:change__stop="@post('{{ refreshGraphs.url() }}')">
            <div class="cluster cluster-between muted">
                <span>50</span><span>2000</span>
            </div>
        </div>
        </div>
    </div>

    {# Graph scale #}
    <div class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Graph Scale</p>
        <div class="segmented" role="group" id="graph_linlog">
            <input type="radio" name="scale" value="linear" checked
                   data-effect="el.checked = $_graph_logscale == false"
                   id="graph_linlog_linear"
                   data-on:change__stop="$_graph_logscale = false; $graph._widget.updateOptions({logscale: false})">
            <label for="graph_linlog_linear" data-size="sm">Linear</label>
            <input type="radio" name="scale" value="logarithmic"
                   data-effect="el.checked = $_graph_logscale == true"
                   id="graph_linlog_log"
                   data-on:change__stop="$_graph_logscale = true; $graph._widget.updateOptions({logscale: true})">
            <label for="graph_linlog_log" data-size="sm">Logarithmic</label>
        </div>
        </div>
    </div>

    {# Series display #}
    <div class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Series Display</p>
        <div class="segmented" role="group"
             data-on:change__stop="const stacked = evt.target.value === 'stacked'; $_graph_stacked = stacked; $graph._widget.updateOptions({stackedGraph: stacked, fillGraph: stacked})">
            <input type="radio" name="type" value="stacked" id="graph_linestacked_stacked"
                   data-effect="el.checked = $_graph_stacked == true">
            <label data-size="sm" for="graph_linestacked_stacked">Stacked</label>
            <input type="radio" name="type" value="line" id="graph_linestacked_line" checked
                   data-effect="el.checked = $_graph_stacked == false">
            <label data-size="sm" for="graph_linestacked_line">Line</label>
        </div><br>
        <div class="segmented" role="group" id="graph_lineplot">
            <input type="radio" name="lineplot" value="step" checked
                   data-effect="el.checked = $_graph_stepplot == true"
                   id="graph_lineplot_step"
                   data-on:change__stop="$_graph_stepplot = true; $graph._widget.updateOptions({stepPlot: true})">
            <label data-size="sm" for="graph_lineplot_step">Step plot</label>
            <input type="radio" name="lineplot" value="curve"
                   data-effect="el.checked = $_graph_stepplot == false"
                   id="graph_lineplot_curve"
                   data-on:change__stop="$_graph_stepplot = false; $graph._widget.updateOptions({stepPlot: false})">
            <label data-size="sm" for="graph_lineplot_curve">Curve plot</label>
        </div>
        </div>
    </div>

</div>
