{#
    IP info modal fragment — pushed by the server as a Datastar patchElements event.
    Replaces #ip-modal-placeholder in the DOM, then JS calls .showModal() on #ip-modal-inner.
    Uses a native <dialog> element — no Bootstrap JS / Popper required.
#}
<div id="ip-modal-placeholder">
    <dialog id="ip-modal-inner" aria-labelledby="ipModalLabel">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="ipModalLabel">Info for IP: {{ ip }}</h1>
                <button type="button" class="btn-close" aria-label="Close"
                        data-on:click="document.getElementById('ip-modal-inner').close()"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">Hostname</dt>
                    <dd class="col-sm-9{% if hostname == 'could not be resolved' %} text-secondary fst-italic{% endif %}">{{ hostname }}</dd>
                </dl>

                {# Rows stay curated rather than looping the payload: netbox() returns the raw
                   API object, whose nested values (status, role, tenant) only read well through
                   .label/.name, and which carries id/url/timestamps nobody needs here (#168). #}
                {% if netboxData is defined and netboxData is not empty %}
                    <h3>{{ ip }} (Netbox)</h3>
                    <table class="table table-striped table-hover table-sm">
                        {% if netboxData.address is defined %}
                            <tr><th>Address</th><td>{{ netboxData.address }}</td></tr>
                        {% endif %}
                        {% if netboxData.dns_name is defined and netboxData.dns_name %}
                            <tr><th>DNS name</th><td>{{ netboxData.dns_name }}</td></tr>
                        {% endif %}
                        {% if netboxData.description is defined and netboxData.description %}
                            <tr><th>Description</th><td>{{ netboxData.description }}</td></tr>
                        {% endif %}
                        {% if netboxData.tenant is defined and netboxData.tenant %}
                            <tr><th>Tenant</th><td>{{ netboxData.tenant.name }}</td></tr>
                        {% endif %}
                        {% if netboxData.vrf is defined and netboxData.vrf %}
                            <tr><th>VRF</th><td>{{ netboxData.vrf.name }}</td></tr>
                        {% endif %}
                        {% if netboxData.status is defined %}
                            <tr><th>Status</th><td>{{ netboxData.status.label ?? netboxData.status }}</td></tr>
                        {% endif %}
                        {% if netboxData.role is defined and netboxData.role %}
                            <tr><th>Role</th><td>{{ netboxData.role.label ?? netboxData.role }}</td></tr>
                        {% endif %}
                        {% if netboxData.assigned_object is defined and netboxData.assigned_object %}
                            <tr><th>Assigned to</th><td>{{ netboxData.assigned_object.display ?? netboxData.assigned_object.name ?? '' }}</td></tr>
                        {% endif %}
                    </table>
                {% endif %}

                {# A private IP gets no geo lookup at all (UtilityActions), so without this the
                   else-branch below rendered a bare heading over an empty table (#168). #}
                {% if geoData is defined and geoData is not empty %}
                {% if geoData.error is defined and geoData.error %}
                    <div class="alert alert-warning">{{ geoData.reason ?? 'IP lookup failed' }}</div>
                {% else %}
                    {% set countryName = geoData.country_name ?? geoData.country_code ?? '' %}
                    <h3>
                        {{ ip }}
                        {% if geoData.country_flag is defined and geoData.country_flag %}
                            {# Emoji rather than a flagcdn image: no third-party request, so the
                               modal also works on an install with no outbound internet access.
                               Windows ships no flag glyphs outside Firefox, where this degrades
                               to the boxed country letters. #}
                            <span class="flag-emoji" role="img"
                                  title="{{ countryName }}"
                                  aria-label="{{ countryName }}">{{ geoData.country_flag }}</span>
                        {% endif %}
                    </h3>
                    {% set ignored = ['country_code', 'country_code_iso3', 'country_tld', 'country_area',
                                      'country_population', 'continent_code', 'in_eu', 'network', 'version',
                                      'error', 'reason', 'readme', 'success', 'status', 'message',
                                      'country_flag'] %}
                    <table class="table table-striped table-hover table-sm">
                        {% for key, value in geoData %}
                            {% if key not in ignored %}
                                {# providers differ: a nested object would blow up on string conversion #}
                                <tr><th>{{ key }}</th><td>{{ value is iterable ? value|json_encode : value }}</td></tr>
                            {% endif %}
                        {% endfor %}
                    </table>
                {% endif %}
                {% endif %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-on:click="document.getElementById('ip-modal-inner').close()">Close</button>
            </div>
        </div>
    </dialog>
</div>
