{# IP info (4.0.6, D24): kept in ShellState::$modalHtml and rendered on every sync, so a morph
   neither empties nor closes it; only the client closes it. #}
{% set labels = {
    country_name: 'Country', region: 'Region', city: 'City', postal: 'Postal code',
    timezone: 'Time zone', asn: 'AS number', org: 'Organisation', network: 'Network',
} %}
{# Shown elsewhere in the dialog, or provider bookkeeping nobody needs here. #}
{% set ignored = ['ip', 'source', 'latitude', 'longitude', 'country', 'country_code', 'country_code_iso3',
                  'country_tld', 'country_area', 'country_population', 'continent_code', 'in_eu', 'version',
                  'error', 'reason', 'readme', 'success', 'status', 'message', 'country_flag', 'region_code'] %}
<dialog id="ip-modal-inner" class="ip-info" aria-labelledby="ipModalLabel" data-preserve-attr="open">
    <form method="dialog" class="dialog-content">
        <header class="dialog-header">
            <h2 class="dialog-title" id="ipModalLabel">IP info: <span class="ip-info-address">{{ ip }}</span></h2>
            <button type="submit" data-variant="close" aria-label="Close" title="Close"></button>
        </header>
        <div class="dialog-body stack">
            <dl class="ip-info-fields">
                <dt>Hostname</dt>
                <dd {% if not hostnameFound %}data-kind="none"{% endif %}>{{ hostname }}</dd>
            </dl>

            {# Curated rows, not a loop: the raw Netbox object nests status, role and tenant, and
               carries ids and timestamps nobody needs here (#168). #}
            {% if netboxData is not empty %}
                <section class="ip-info-section" aria-labelledby="ipNetboxHeading">
                    <h3 id="ipNetboxHeading">Netbox</h3>
                    <dl class="ip-info-fields">
                        {% if netboxData.address is defined %}
                            <dt>Address</dt><dd>{{ netboxData.address }}</dd>
                        {% endif %}
                        {% if netboxData.dns_name is defined and netboxData.dns_name %}
                            <dt>DNS name</dt><dd>{{ netboxData.dns_name }}</dd>
                        {% endif %}
                        {% if netboxData.description is defined and netboxData.description %}
                            <dt>Description</dt><dd>{{ netboxData.description }}</dd>
                        {% endif %}
                        {% if netboxData.tenant is defined and netboxData.tenant %}
                            <dt>Tenant</dt><dd>{{ netboxData.tenant.name ?? '' }}</dd>
                        {% endif %}
                        {% if netboxData.vrf is defined and netboxData.vrf %}
                            <dt>VRF</dt><dd>{{ netboxData.vrf.name ?? '' }}</dd>
                        {% endif %}
                        {% if netboxData.status is defined %}
                            <dt>Status</dt><dd>{{ netboxData.status.label ?? netboxData.status }}</dd>
                        {% endif %}
                        {% if netboxData.role is defined and netboxData.role %}
                            <dt>Role</dt><dd>{{ netboxData.role.label ?? netboxData.role }}</dd>
                        {% endif %}
                        {% if netboxData.assigned_object is defined and netboxData.assigned_object %}
                            <dt>Assigned to</dt><dd>{{ netboxData.assigned_object.display ?? netboxData.assigned_object.name ?? '' }}</dd>
                        {% endif %}
                    </dl>
                    <p class="ip-info-source">Source: Netbox</p>
                </section>
            {% endif %}

            {% if geoData is not empty %}
                <section class="ip-info-section" aria-labelledby="ipGeoHeading">
                    <h3 id="ipGeoHeading">Location</h3>
                    {% if geoData.error is defined and geoData.error %}
                        <div class="notice" data-level="warning" role="status">
                            <span class="status-dot" data-level="warning" aria-hidden="true"></span>
                            <span>{{ geoData.reason ?? 'IP lookup failed.' }}</span>
                        </div>
                    {% else %}
                        {% set countryName = geoData.country_name ?? geoData.country_code ?? '' %}
                        <dl class="ip-info-fields">
                            {% for key, label in labels %}
                                {% if geoData[key] is defined and geoData[key] is not same as('') and geoData[key] is not null %}
                                    <dt>{{ label }}</dt>
                                    <dd>
                                        {% if key == 'country_name' and geoData.country_flag is defined and geoData.country_flag %}
                                            {# Emoji rather than a flag image: no third-party request, so the modal
                                               also works offline. Windows shows the boxed letters instead. #}
                                            <span class="flag-emoji" role="img" title="{{ countryName }}" aria-label="{{ countryName }}">{{ geoData.country_flag }}</span>
                                        {% endif %}
                                        {{ geoData[key] is iterable ? geoData[key]|json_encode : geoData[key] }}
                                    </dd>
                                {% endif %}
                            {% endfor %}
                            {% if geoData.latitude is defined and geoData.longitude is defined %}
                                <dt>Coordinates</dt><dd>{{ geoData.latitude }}, {{ geoData.longitude }}</dd>
                            {% endif %}
                            {% for key, value in geoData %}
                                {% if key not in ignored and labels[key] is not defined and value is not same as('') and value is not null %}
                                    {# Providers differ: a nested object would fail on string conversion. #}
                                    <dt>{{ key|replace({'_': ' '})|capitalize }}</dt>
                                    <dd>{{ value is iterable ? value|json_encode : value }}</dd>
                                {% endif %}
                            {% endfor %}
                        </dl>
                    {% endif %}
                    {% if geoSource %}<p class="ip-info-source">Source: {{ geoSource }}</p>{% endif %}
                </section>
            {% elseif isPrivate and netboxData is empty %}
                <p class="ip-info-source">A private address has no public location to look up.</p>
            {% endif %}
        </div>
        <footer class="dialog-footer">
            <button type="submit" autofocus>Close</button>
        </footer>
    </form>
    {# A modal makes the rest of the page inert, so a toast shown meanwhile lands here (nfsen-toast.js). #}
    <div class="toast-stack" data-ignore-morph></div>
</dialog>
