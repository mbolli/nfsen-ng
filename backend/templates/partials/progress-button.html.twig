{#
    Query control (2.5): Run, Kill, progress and status, shared by every panel that runs a query.

    Params:
      label      idle button text
      action     action URL to POST on click
      running    server-owned bool signal, true while the query runs
      permille   server-owned int signal, 0..1000
      status     server-owned string signal, e.g. "Scanning 42 / 288 intervals"
      eta        server-owned string signal, e.g. "~1m 30s"
      exact      server-owned bool signal; false renders the figure as an estimate
      kindSignal server-owned string signal naming the panel that owns the running query
      kind       this panel's name; progress renders only when kindSignal matches it
      killAction action URL for the Kill button
      id         DOM id prefix, so several of these can coexist
      run        optional query target, rendered as data-run on the button (e2e runQuery())
      onClick    optional extra JS to run before the POST
      doneText   optional JS expression announced after a successful run, e.g. "$flows_count + ' flows returned'"
#}
{# Panels on one page share the query_* signals, so only this panel's query drives its progress.
   `disabled` keys off the bare running flag, since one query runs at a time. #}
{% set here = '($' ~ running ~ " && $" ~ kindSignal ~ " === '" ~ kind ~ "')" %}
{% set mine = "$" ~ kindSignal ~ " === '" ~ kind ~ "'" %}
{% set done = doneText is defined and doneText
    ? "(String($" ~ status ~ ").startsWith('Done') ? (" ~ doneText ~ ") + '. ' + $" ~ status ~ " : $" ~ status ~ ")"
    : '$' ~ status %}
<div class="query-control" id="{{ id }}"
     data-query-state="idle" data-attr:data-query-state="{{ here }} ? 'running' : 'idle'"
     data-preserve-attr="data-query-state">
    <button type="button"
            data-variant="primary"
            id="{{ id }}Submit"{% if run is defined and run %}
            data-run="{{ run }}"{% endif %}
            data-attr:disabled="${{ running }}"
            data-on:click="{{ onClick|default('') }}@post('{{ action }}')">
        <span class="spinner" aria-hidden="true"></span>
        <span class="query-label">{{ label }}</span>
        <span class="query-label-running">Processing…</span>
    </button>

    <button type="button"
            class="kill"
            data-size="sm"
            title="Stop this query"
            hidden data-attr:hidden="!{{ here }}" data-preserve-attr="hidden"
            data-on:click="@post('{{ killAction }}')">Kill</button>

    {# The bar exists only while the query runs; the status line outlives it ("Done in 1.2s."). #}
    <div class="query-progress"
         hidden data-attr:hidden="!({{ here }} || (${{ status }} !== '' && {{ mine }}))" data-preserve-attr="hidden">
        <progress max="1000" aria-label="Query progress"
                  hidden data-attr:hidden="!{{ here }}" data-preserve-attr="hidden"
                  data-attr:data-indeterminate="!${{ exact }}"
                  data-attr:value="${{ permille }}"></progress>
        <div class="query-progress-line cluster" data-justify="between">
            <span data-text="${{ status }}"></span>
            <span class="query-progress-figures" hidden data-attr:hidden="!{{ here }}" data-preserve-attr="hidden">
                <span data-text="(${{ permille }} / 10).toFixed(1) + '%'"></span>
                <span hidden data-attr:hidden="${{ exact }}" data-preserve-attr="hidden" title="Estimated from bytes read">(est.)</span>
                <span hidden data-attr:hidden="${{ eta }} === ''" data-preserve-attr="hidden" data-text="'· ' + ${{ eta }}"></span>
            </span>
        </div>
    </div>

    {# Announces the start, every 25 %, then the outcome of a run it saw start; never morphed. #}
    <span class="visually-hidden" role="status" data-ignore-morph
          data-effect="let t = el.textContent; if ({{ here }}) { el.qkRan = true; const q = Math.min(75, Math.floor(${{ permille }} / 250) * 25); t = q > 0 ? q + ' percent' : 'Query started' } else if (el.qkRan && {{ mine }}) { el.qkRan = false; t = {{ done }} } if (el.textContent !== t) el.textContent = t"></span>
</div>
