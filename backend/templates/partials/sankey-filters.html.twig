{#
    Sankey diagram filter controls.
#}
<div class="stack">
<div class="filter-grid query-fields" id="conversationsQueryFields">
    {# Top N pairs #}
    <div id="filterSankeyTopN" class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Top pairs
            <nfsen-tooltip data-ignore-morph text="Number of top N src -> dst pairs to display (-n option)." placement="top"></nfsen-tooltip>
        </p>
        {% set _sankeyTopN = sankey_topN.int() %}
        <select {{ bind(sankey_topN) }} >
            {% for n in [10, 20, 50, 100, 200] %}
            <option value="{{ n }}"{{ _sankeyTopN == n ? ' selected' : '' }}>{{ n }}</option>
            {% endfor %}
        </select>
        </div>
    </div>

    {# Sources #}
    <div id="filterSankeySources" class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Sources
            <nfsen-tooltip data-ignore-morph text="NetFlow sources to query. Multiple sources merged with -M." placement="top"></nfsen-tooltip>
        </p>
        <select {{ bind(graph_sources) }} multiple >
            <option value="any">Any</option>
            {% for source in sources %}
            <option value="{{ source }}" selected>{{ source }}</option>
            {% endfor %}
        </select>
        </div>
    </div>

    {# NFDUMP filter #}
    <div class="filter-cell filter-cell--wide">
        <div class="filter-group">
        <p class="filter-label">NFDUMP filter
            <nfsen-tooltip data-ignore-morph text="Filter syntax like tcpdump. Examples: 'dst port 80', 'bytes > 10M'" placement="right"></nfsen-tooltip>
        </p>
        {% include 'components/filter-field.html.twig' with {target: 'conversations', signal: sankey_filter, textareaId: 'filterNfdumpTextareaSankey'} %}
        </div>
    </div>

    {# Byte thresholds, prepended to the nfdump filter expression. One card rather than
       two: a single narrow input each left them stranded in half-empty cards, and they
       are one setting with two ends. #}
    <div class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Bytes per flow
            <nfsen-tooltip data-ignore-morph text="Keep only flows within this byte range. Prepended to the filter as 'bytes &gt; min' / 'bytes &lt; max'. Accepts SI suffixes: k, M, G." placement="top"></nfsen-tooltip>
        </p>
        <div class="filter-subgrid filter-subgrid--tight">
            <div>
                <label class="filter-sublabel" for="sankey_lower_limitInput">Min</label>
                <input type="text" id="sankey_lower_limitInput" {{ bind(sankey_lower_limit) }}  placeholder="e.g. 1M"
                       title="Only aggregate flows with at least this many bytes. Prepended as 'bytes &gt; value' filter. Accepts SI suffixes: k, M, G. E.g. '1M'.">
            </div>
            <div>
                <label class="filter-sublabel" for="sankey_upper_limitInput">Max</label>
                <input type="text" id="sankey_upper_limitInput" {{ bind(sankey_upper_limit) }}  placeholder="e.g. 100M"
                       title="Only aggregate flows with at most this many bytes. Prepended as 'bytes &lt; value' filter. Accepts SI suffixes: k, M, G.">
            </div>
        </div>
        </div>
    </div>

    {# Metric: which volume ranks and sizes the top-N pairs and links #}
    <div id="filterSankeyMetric" class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Rank / size by
            <nfsen-tooltip data-ignore-morph text="Which metric selects the top N pairs (-O option) and sizes the link ribbons." placement="top"></nfsen-tooltip>
        </p>
        {% set _sankeyMetric = sankey_metric.string() %}
        <div class="segmented"  role="group">
            <input type="radio"  name="sankeyMetric" value="bytes"{{ _sankeyMetric != 'packets' ? ' checked' : '' }}
                   id="sankeyMetricBytes" {{ bind(sankey_metric) }}>
            <label data-size="sm" for="sankeyMetricBytes">Bytes</label>
            <input type="radio"  name="sankeyMetric" value="packets"{{ _sankeyMetric == 'packets' ? ' checked' : '' }}
                   id="sankeyMetricPackets" {{ bind(sankey_metric) }}>
            <label data-size="sm" for="sankeyMetricPackets">Packets</label>
        </div>
        </div>
    </div>

    {# Ports: optional middle column (src IP -> dst port -> dst IP) #}
    <div id="filterSankeyPorts" class="filter-cell">
        <div class="filter-group">
        <p class="filter-label">Ports
            <nfsen-tooltip data-ignore-morph text="Add the destination L4 port as a middle column: src IP &rarr; dst port &rarr; dst IP. Aggregates on the port too, so the top-N covers src/port/dst tuples." placement="top"></nfsen-tooltip>
        </p>
        <div class="choice switch">
            <input  type="checkbox" role="switch"
                   id="sankeyShowPorts" {{ bind(sankey_show_ports) }}>
            <label  for="sankeyShowPorts">Show dst port</label>
        </div>
        </div>
    </div>
</div>

    {# Submit. The run is one request, so Datastar's indicator is its running state. #}
    <div class="filter-submit">
        <div class="query-control cluster" id="sankeyRun" data-signals__ifmissing="{sankey: {_indicator: false}}"
             data-query-state="idle" data-attr:data-query-state="$sankey._indicator ? 'running' : 'idle'"
             data-preserve-attr="data-query-state">
        <nfsen-tooltip data-ignore-morph text="Generate the Sankey diagram using nfdump -a with current filters" placement="top" no-icon>
            <button type="button"
                    data-variant="primary"
                    data-run="conversations"
                    data-indicator:sankey._indicator
                    data-on:click="$_sankey_queried = true; @post('{{ sankeyActions.url() }}')">
                <span data-show="!$sankey._indicator">Process data</span>
                <span class="spinner" data-show="$sankey._indicator" aria-hidden="true"></span>
                <span data-show="$sankey._indicator">Processing…</span>
            </button>
        </nfsen-tooltip>
        <button type="button"
                class="kill" data-size="sm"
                hidden data-attr:hidden="!$sankey._indicator" data-preserve-attr="hidden"
                data-on:click="@post('{{ killNfdump.url() }}')">Kill</button>
        {% include 'components/query-estimate.html.twig' with {target: 'conversations'} %}
        </div>
    </div>

</div>
