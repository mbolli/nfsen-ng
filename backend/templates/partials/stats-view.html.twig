{#
    Statistics results panel.
#}
<div  data-signals__ifmissing='{"_stats_queried": false}'>
    <div>
        {# Empty state — shown until the user submits the first query #}
        <div data-show="!$_stats_queried" class="center muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor"  viewBox="0 0 16 16">
                <path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/>
            </svg>
            <p class="strong">No results yet</p>
            <p class="muted">Configure filters above and click <strong>Process data</strong> to generate statistics.</p>
        </div>
        {# Results card — shown after the first query #}
        <div data-show="$_stats_queried">
        <div class="card" data-class:loading="${{ query_running.id() }}">
            <div class="card-body">
                <div class="cluster cluster-between">
                    <h5 class="strong">Output</h5>
                    <div class="cluster">
                        <span class="badge" data-level="info" data-text="${{ stats_count.id() }}"></span>
                        <span class="muted">rows</span>
                    </div>
                </div>
                <div id="statsMessage">
                    {% for n in statsNotifications %}
                    <div class="notice dismissible" data-level="{{ n.type }}" role="alert">
                        {{ n.message|raw }}
                        <button type="button" data-variant="close" data-on:click="@post('{{ dismissNotification.url() }}?id={{ n.id }}')" aria-label="Close"></button>
                    </div>
                    {% endfor %}
                </div>
                <div id="statsTable">{{ statsTableHtml|raw }}</div>
            </div>
        </div>
        </div>
    </div>
</div>
