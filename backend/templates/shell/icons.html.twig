{# Line icons on a 16px grid in currentColor. Decorative (aria-hidden) unless given a label,
   for an icon that is the whole accessible name. #}
{% macro icon(name, label = '') %}
    {%- set paths = {
        'logo': '<path d="M1.5 11.5c2.5 0 2.5-7 5-7s2.5 7 5 7 2.5-3.5 3-3.5"/><path d="M1.5 14.5h13"/>',
        'chart-area': '<path d="M1.5 1.5v13h13"/><path d="m4 11 3-4 2.5 2L14 3.5"/>',
        'list-ranked': '<path d="M2 3.5h1M2 8h1M2 12.5h1"/><path d="M5.5 3.5h8.5M5.5 8h6M5.5 12.5h3.5"/>',
        'rows': '<rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5"/><path d="M1.75 6.25h12.5M1.75 9.75h12.5"/>',
        'arrows-exchange': '<path d="M2 5h11M10.5 2.5 13 5l-2.5 2.5"/><path d="M14 11H3M5.5 8.5 3 11l2.5 2.5"/>',
        'bell': '<path d="M3.5 11.5V7a4.5 4.5 0 0 1 9 0v4.5l1 1.25h-11z"/><path d="M6.5 14.25a1.5 1.5 0 0 0 3 0"/>',
        'heart-pulse': '<path d="M1 8.5h3l1.5-3.5 2.5 7 2-5 1 1.5h4"/>',
        'gear': '<circle cx="8" cy="8" r="2.25"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/>',
        'sun': '<circle cx="8" cy="8" r="3"/><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06"/>',
        'moon': '<path d="M13.5 10.25A6 6 0 0 1 5.75 2.5a6 6 0 1 0 7.75 7.75z"/>',
        'reload': '<path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9"/><path d="M13.5 1.75V5h-3.25"/>',
        'sidebar': '<rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5"/><path d="M6 2.25v11.5"/>',
        'more': '<circle cx="3" cy="8" r="0.5"/><circle cx="8" cy="8" r="0.5"/><circle cx="13" cy="8" r="0.5"/>',
        'import': '<path d="M2.75 6.5a5.5 5.5 0 0 1 9.9-2.1"/><path d="M13 1.75v3h-3"/><path d="M13.25 9.5a5.5 5.5 0 0 1-9.9 2.1"/><path d="M3 14.25v-3h3"/>',
        'clock': '<circle cx="8" cy="8" r="6.25"/><path d="M8 4.5V8l2.5 1.5"/>',
        'back': '<path d="M13.5 8H3"/><path d="M6.5 4.5 3 8l3.5 3.5"/>',
        'forward': '<path d="M2.5 8H13"/><path d="M9.5 4.5 13 8l-3.5 3.5"/>',
        'now': '<path d="M2 8h9"/><path d="M8 5l3 3-3 3"/><path d="M14 2.5v11"/>',
        'undo': '<path d="M3 6.5h7a3.5 3.5 0 0 1 0 7H6"/><path d="M6 3.5 3 6.5l3 3"/>',
        'zoom-out': '<circle cx="7" cy="7" r="4.75"/><path d="M4.75 7h4.5M10.5 10.5 14 14"/>',
        'plus': '<path d="M8 3v10M3 8h10"/>',
        'edit': '<path d="M10.25 2.75 13.25 5.75 5.5 13.5h-3v-3z"/><path d="m8.75 4.25 3 3"/>',
        'play': '<path d="M4.75 2.75v10.5L13 8z"/>',
        'trash': '<path d="M2.5 4.25h11"/><path d="M6.25 4.25v-1.5h3.5v1.5"/><path d="m3.75 4.25.75 9h7l.75-9"/><path d="M6.75 7v3.5M9.25 7v3.5"/>',
    } -%}
    <svg class="icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false" {% if label %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %}>{{ (paths[name] ?? '')|raw }}</svg>
{%- endmacro %}
