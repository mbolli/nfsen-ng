{
  "name": "mbolli/nfsen-ng",
  "version": "1.0.0-beta.5",
  "description": "Responsive NetFlow visualizer built on top of nfdump tools",
  "license": "Apache-2.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "/develop/php-via"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-inotify": "*",
    "ext-mbstring": "*",
    "ext-openswoole": "*",
    "ext-rrd": "*",
    "maxmind-db/reader": "^1.12",
    "mbolli/php-via": "dev-nfsen-ng/release-0.14 as 0.14.0",
    "mcp/sdk": "^0.8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.x",
    "jetbrains/phpstorm-attributes": "^1.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-arch": "^5.0",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "mbolli\\nfsen_ng\\": "backend/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "before-commit": [
      "@fix",
      "@test-phpstan"
    ],
    "lint": "@fix --dry-run",
    "lint-diff": "@fix --dry-run --diff",
    "fix": "php-cs-fixer fix --ansi --allow-risky=yes -v --config=./.php-cs-fixer.php",
    "test-phpstan": "phpstan analyse backend -a backend/settings/settings.php",
    "test": "pest",
    "test-coverage": "pest --coverage"
  },
  "authors": [
    {
      "name": "Michael Bolli",
      "email": "michael@bolli.us"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
